// Prisma schema for ProspectFlow.
// Entity design source of truth: ../DATA_MODEL.md — keep this file in sync with it.
// Sprint 0 scope only: Tenant, User, CommercialProfile (see MVP_BACKLOG.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // No `url` here (Prisma 7 no longer supports it in schema.prisma): the generated
  // client connects via a driver adapter (see src/lib/db.ts, using DATABASE_URL).
  // Migrations/introspection use DIRECT_URL, configured in prisma.config.ts.
}

enum Role {
  OWNER
  MEMBER
}

model Tenant {
  id                String             @id @default(uuid())
  name              String
  users             User[]
  commercialProfile CommercialProfile?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model User {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  supabaseUserId String   @unique
  email          String   @unique
  role           Role     @default(OWNER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

model CommercialProfile {
  id               String   @id @default(uuid())
  tenantId         String   @unique
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  valueProposition String
  toneDescription  String
  servicesOffered  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
